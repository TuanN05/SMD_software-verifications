    {
      "name": "Function 43 - Check Circular Dependency",
      "item": [
        {
          "name": "ITC_43.1 - No circular dependency",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains wouldCreateCircular = false\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('wouldCreateCircular', false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": 101,\n  \"relatedCourseId\": 102\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/course-relationships/check-circular",
              "host": ["{{baseUrl}}"],
              "path": ["api", "course-relationships", "check-circular"]
            },
            "description": "Test checking relationship that won't create circular dependency"
          }
        },
        {
          "name": "ITC_43.2 - Would create circular dependency",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
