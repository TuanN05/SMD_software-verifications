{
  "name": "smd-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-End tests for SMD application using CodeceptJS with Playwright",
  "scripts": {
    "test:e2e": "codeceptjs run",
    "test:e2e:headed": "codeceptjs run --headed",
    "test:e2e:headless": "set HEADLESS=true && codeceptjs run",
    "test:e2e:debug": "codeceptjs run --debug",
    "test:e2e:ui": "codeceptjs ui"
  },
  "devDependencies": {
    "@codeceptjs/configure": "^1.0.6",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "codeceptjs": "^3.7.8",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
