    {
      "name": "Function 13: Initialize default roles",
      "item": [
        {
          "name": "ITC_13.1 - Initialize on empty database",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Response contains success message', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(typeof jsonData).to.equal('string');",
                  "    pm.expect(jsonData).to.include('initialized');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/roles/initialize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles", "initialize"]
            }
          }
        },
        {
          "name": "ITC_13.2 - Verify default roles created",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('All 6 default roles exist', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var roleNames = jsonData.map(r => r.roleName);",
                  "    pm.expect(roleNames).to.include('ADMIN');",
                  "    pm.expect(roleNames).to.include('LECTURER');",
                  "    pm.expect(roleNames).to.include('HEAD_OF_DEPARTMENT');",
                  "    pm.expect(roleNames).to.include('ACADEMIC_AFFAIRS');",
                  "    pm.expect(roleNames).to.include('PRINCIPAL');",
                  "    pm.expect(roleNames).to.include('STUDENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles"]
            }
          }
        },
        {
          "name": "ITC_13.3 - Idempotency (second initialize)",
          "event": [
