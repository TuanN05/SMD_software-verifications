    {
      "name": "Function 12: Create a new role",
      "item": [
        {
          "name": "ITC_12.1 - Valid role name (COORDINATOR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Response contains role', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.roleName).to.equal('COORDINATOR');",
                  "});",
                  "",
                  "pm.test('Role has roleId', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.roleId).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleName\": \"COORDINATOR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles"]
            }
          }
        },
        {
          "name": "ITC_12.2 - Duplicate role name (MANAGER)",
